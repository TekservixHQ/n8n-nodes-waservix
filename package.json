{
	"name": "n8n-nodes-waservix",
	"version": "1.0.0",
	"description": "n8n nodes for WAservix: send WhatsApp messages from your own number, and start workflows on incoming messages and status updates.",
	"license": "MIT",
	"homepage": "https://tekservix.com/waservix/",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"whatsapp",
		"whatsapp-api",
		"whatsapp-gateway",
		"messaging",
		"waservix",
		"tekservix"
	],
	"author": {
		"name": "Tekservix",
		"email": "support@tekservix.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/TekservixHQ/n8n-nodes-waservix.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/WAservixApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/WAservix/WAservix.node.js",
			"dist/nodes/WAservixTrigger/WAservixTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.56.1",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"bugs": {
		"url": "https://github.com/TekservixHQ/n8n-nodes-waservix/issues"
	}
}
